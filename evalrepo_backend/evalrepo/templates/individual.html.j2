<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Informe — {{ result.student }}/{{ result.repo_name }}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
         background: #F1F5F9; color: #0F172A; font-size: 14px; line-height: 1.6; }
  .container { max-width: 820px; margin: 32px auto; padding: 0 16px 48px; }

  /* Header */
  .header { background: #1B3A5C; color: white; border-radius: 12px; padding: 28px 32px; margin-bottom: 20px; }
  .header h1 { font-size: 20px; font-weight: 600; margin-bottom: 6px; }
  .header .meta { opacity: 0.65; font-size: 13px; }
  .score-row { display: flex; align-items: center; gap: 20px; margin-top: 18px; }
  .score-circle { width: 80px; height: 80px; border-radius: 50%; border: 5px solid;
                  display: flex; flex-direction: column; align-items: center;
                  justify-content: center; flex-shrink: 0; }
  .score-circle .num { font-size: 26px; font-weight: 700; line-height: 1; }
  .score-circle .den { font-size: 11px; opacity: 0.7; }
  .score-circle.pass  { border-color: #34D399; background: rgba(52,211,153,0.15); }
  .score-circle.risk  { border-color: #FBBF24; background: rgba(251,191,36,0.15); }
  .score-circle.fail  { border-color: #F87171; background: rgba(248,113,113,0.15); }

  /* Badges */
  .badge { display: inline-block; padding: 3px 12px; border-radius: 999px;
           font-size: 12px; font-weight: 600; }
  .badge-success { background: #ECFDF5; color: #065F46; }
  .badge-warning { background: #FFFBEB; color: #92400E; }
  .badge-danger  { background: #FEF2F2; color: #991B1B; }
  .badge-neutral { background: #F1F5F9; color: #475569; }

  /* Cards */
  .card { background: white; border: 1px solid #E2E8F0; border-radius: 12px;
          padding: 20px 24px; margin-bottom: 16px; }
  .card h2 { font-size: 15px; font-weight: 600; margin-bottom: 16px;
              display: flex; align-items: center; gap: 8px; }
  .card h2 .icon { font-size: 18px; }

  /* Grid */
  .dim-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 16px; }
  .dim-card { background: white; border: 1px solid #E2E8F0; border-radius: 10px;
               padding: 14px; text-align: center; }
  .dim-card .label { font-size: 12px; color: #64748B; margin-bottom: 6px; }
  .dim-card .pts { font-size: 22px; font-weight: 700; }
  .dim-card .max { font-size: 12px; color: #94A3B8; }
  .dim-card .bar { height: 4px; background: #F1F5F9; border-radius: 999px; margin-top: 8px; }
  .dim-card .bar-fill { height: 100%; border-radius: 999px; background: #2563EB; }

  /* Alerts */
  .alert-box { background: #FFFBEB; border: 1px solid #FCD34D; border-radius: 10px;
                padding: 14px 18px; margin-bottom: 16px; }
  .alert-box h3 { font-size: 13px; color: #92400E; font-weight: 600; margin-bottom: 8px; }
  .alert-box ul { padding-left: 18px; }
  .alert-box li { color: #78350F; margin-bottom: 3px; font-size: 13px; }

  /* Weekly table */
  .weekly-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .weekly-table th { text-align: left; padding: 7px 10px; background: #F8FAFC;
                     border-bottom: 1px solid #E2E8F0; color: #64748B;
                     font-size: 12px; font-weight: 600; text-transform: uppercase; }
  .weekly-table td { padding: 7px 10px; border-bottom: 1px solid #F1F5F9; }
  .weekly-table tr:last-child td { border-bottom: none; }
  .bar-cell { min-width: 120px; }
  .bar-inline { height: 8px; border-radius: 4px; background: #3B82F6; display: inline-block; }
  .bar-zero  { background: #E2E8F0; }

  /* File table */
  .file-row { display: flex; align-items: center; justify-content: space-between;
               padding: 8px 12px; border-radius: 6px; margin-bottom: 4px; font-size: 13px; }
  .file-row.present { background: #ECFDF5; }
  .file-row.absent  { background: #FEF2F2; }
  .file-row code { font-family: monospace; font-size: 12px; }

  /* Footer */
  .footer { text-align: center; color: #94A3B8; font-size: 12px; margin-top: 32px; }

  /* Override banner */
  .override-box { background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 10px;
                   padding: 12px 18px; margin-bottom: 16px; font-size: 13px; color: #1E3A8A; }

  /* Contributors / commit log */
  .contrib-row { display: flex; align-items: center; justify-content: space-between;
                  padding: 7px 10px; border-bottom: 1px solid #F1F5F9; font-size: 13px; }
  .contrib-row:last-child { border-bottom: none; }
  .commit-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .commit-table th { text-align: left; padding: 6px 10px; background: #F8FAFC;
                      border-bottom: 1px solid #E2E8F0; color: #64748B;
                      font-weight: 600; text-transform: uppercase; font-size: 11px; }
  .commit-table td { padding: 6px 10px; border-bottom: 1px solid #F8FAFC; }
  .commit-table code { font-family: monospace; }
</style>
</head>
<body>
<div class="container">

  <!-- Header -->
  <div class="header">
    <h1>{{ result.student }} / {{ result.repo_name }}</h1>
    <div class="meta">{{ result.url }}</div>
    <div class="score-row">
      {% set sc = result.global_score %}
      <div class="score-circle {% if sc >= 70 %}pass{% elif sc >= 50 %}risk{% else %}fail{% endif %}">
        <span class="num">{{ sc | round(1) }}</span>
        <span class="den">/100</span>
      </div>
      <div>
        <div style="margin-bottom:8px">
          <span class="badge {% if result.temporal and result.temporal.on_time %}badge-success{% else %}badge-danger{% endif %}">
            {% if result.temporal and result.temporal.on_time %}Entregado a tiempo{% else %}Entregado tarde{% endif %}
          </span>
          &nbsp;
          <span class="badge badge-neutral">{{ result.pattern_label }}</span>
        </div>
        <div style="font-size:13px; opacity:0.75">Generado: {{ generated_at }}</div>
      </div>
    </div>
  </div>

  <!-- Ajuste manual del docente -->
  {% if result.score_overridden %}
  <div class="override-box">
    <strong>Puntaje ajustado manualmente por el docente.</strong>
    Puntaje calculado por el sistema: {{ result.original_score | round(1) }}/100.
    {% if result.override_note %}<br>Justificación: {{ result.override_note }}{% endif %}
  </div>
  {% endif %}

  <!-- Alerts -->
  {% if result.alerts %}
  <div class="alert-box">
    <h3>Alertas detectadas</h3>
    <ul>
      {% for alert in result.alerts %}
      <li>{{ alert }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <!-- Dimension breakdown -->
  <div class="dim-grid">
    {% set dims = [
      ("Estructural", result.structural),
      ("Versionado",  result.versioning),
      ("Temporal",    result.temporal),
      ("Contenido",   result.content),
    ] %}
    {% for name, dim in dims %}
    <div class="dim-card">
      <div class="label">{{ name }}</div>
      {% if dim %}
      <div class="pts">{{ dim.score | round(1) }}</div>
      <div class="max">/ {{ dim.max_score | round(0) | int }} pts</div>
      <div class="bar"><div class="bar-fill" style="width:{{ ((dim.score / dim.max_score) * 100) | round(0) | int if dim.max_score > 0 else 0 }}%"></div></div>
      {% else %}
      <div class="pts" style="color:#94A3B8">—</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <!-- Structural detail -->
  {% if result.structural %}
  <div class="card">
    <h2>Archivos requeridos</h2>
    {% for f in result.structural.files_found %}
    <div class="file-row present"><code>{{ f }}</code><span style="color:#065F46;font-weight:600">Presente</span></div>
    {% endfor %}
    {% for f in result.structural.files_missing %}
    <div class="file-row absent"><code>{{ f }}</code><span style="color:#991B1B;font-weight:600">Ausente</span></div>
    {% endfor %}
    <div style="margin-top:12px;font-size:13px;color:#64748B">
      README: {{ result.structural.readme_char_count }} caracteres
      (mínimo: {{ result.structural.details.readme_min_chars }}) —
      {% if result.structural.readme_ok %}<span style="color:#065F46">Cumple</span>{% else %}<span style="color:#991B1B">Insuficiente</span>{% endif %}
    </div>
    {% if result.structural.branch_checks %}
    <div style="margin-top:14px">
      <div style="font-size:12px;color:#64748B;margin-bottom:6px">Archivos requeridos en ramas específicas:</div>
      {% for c in result.structural.branch_checks %}
      <div class="file-row {% if c.found %}present{% else %}absent{% endif %}">
        <code>{{ c.path }}</code>
        <span>en rama <code>{{ c.branch }}</code></span>
        <span style="color:{% if c.found %}#065F46{% else %}#991B1B{% endif %};font-weight:600">
          {{ 'Presente' if c.found else 'Ausente' }}
        </span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if result.structural.alternative_checks %}
    <div style="margin-top:14px">
      <div style="font-size:12px;color:#64748B;margin-bottom:6px">Archivos en carpetas alternativas:</div>
      {% for c in result.structural.alternative_checks %}
      <div class="file-row {% if c.found %}present{% else %}absent{% endif %}">
        <code>{{ c.nombre }}</code>
        <span>en {{ c.carpetas | join(' ó ') }}</span>
        <span style="color:{% if c.found %}#065F46{% else %}#991B1B{% endif %};font-weight:600">
          {{ 'Encontrado en ' + c.found_in if c.found else 'No encontrado' }}
        </span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- Versioning detail -->
  {% if result.versioning %}
  <div class="card">
    <h2>Versionado</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
      <div>
        <div style="font-size:12px;color:#64748B;margin-bottom:4px">Commits totales</div>
        <div style="font-size:20px;font-weight:700;color:{% if result.versioning.commits_ok %}#065F46{% else %}#991B1B{% endif %}">
          {{ result.versioning.total_commits }}
        </div>
        <div style="font-size:12px;color:#94A3B8">mínimo: {{ result.versioning.details.commits_min }}</div>
      </div>
      <div>
        <div style="font-size:12px;color:#64748B;margin-bottom:4px">Calidad mensajes</div>
        <div style="font-size:20px;font-weight:700;color:{% if result.versioning.quality_ok %}#065F46{% else %}#991B1B{% endif %}">
          {{ result.versioning.quality_pct }}%
        </div>
        <div style="font-size:12px;color:#94A3B8">umbral: {{ result.versioning.details.quality_umbral }}%</div>
      </div>
      <div>
        <div style="font-size:12px;color:#64748B;margin-bottom:4px">Ramas activas</div>
        <div style="font-size:20px;font-weight:700;color:{% if result.versioning.branches_ok %}#065F46{% else %}#991B1B{% endif %}">
          {{ result.versioning.branch_count }}
        </div>
        <div style="font-size:12px;color:#94A3B8">mínimo: {{ result.versioning.details.min_ramas }}</div>
      </div>
    </div>
    {% if result.versioning.generic_messages %}
    <div style="margin-top:14px;background:#F8FAFC;border-radius:8px;padding:10px 14px">
      <div style="font-size:12px;color:#64748B;margin-bottom:6px">Ejemplos de mensajes genéricos detectados:</div>
      {% for msg in result.versioning.generic_messages %}
      <code style="display:block;font-size:12px;color:#475569;margin-bottom:2px">"{{ msg }}"</code>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- Temporal / Weekly activity -->
  {% if result.temporal and result.temporal.weekly_breakdown %}
  <div class="card">
    <h2>Actividad semanal de commits</h2>
    <table class="weekly-table">
      <thead><tr><th>Del — al</th><th>Commits</th><th class="bar-cell">Distribución</th></tr></thead>
      <tbody>
        {% set max_commits = result.temporal.weekly_breakdown | map(attribute='count') | max %}
        {% for w in result.temporal.weekly_breakdown %}
        <tr>
          <td>{{ w.start_date }} — {{ w.end_date }}</td>
          <td><strong>{{ w.count }}</strong></td>
          <td class="bar-cell">
            <span class="bar-inline {% if w.count == 0 %}bar-zero{% endif %}"
                  style="width:{{ (w.count / max_commits * 120) | round(0) | int if max_commits > 0 else 0 }}px"></span>
            {% if w.count == 0 %}<span style="color:#94A3B8;font-size:12px"> sin actividad</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <div style="margin-top:12px;font-size:13px;color:#64748B">
      Semanas activas: <strong>{{ result.temporal.active_weeks }}</strong> de {{ result.temporal.total_weeks }} |
      Concentración final: <strong>{{ result.temporal.concentration_pct }}%</strong>
    </div>
  </div>
  {% endif %}

  <!-- Colaboradores -->
  {% if result.versioning and result.versioning.contributors %}
  <div class="card">
    <h2>Colaboradores</h2>
    {% for c in result.versioning.contributors %}
    <div class="contrib-row">
      <span>{{ c.author }}</span>
      <span><strong>{{ c.commits }}</strong> commit{{ 's' if c.commits != 1 else '' }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- Historial de commits -->
  {% if result.versioning and result.versioning.commit_log %}
  <div class="card">
    <h2>Historial de commits</h2>
    <table class="commit-table">
      <thead><tr><th>Fecha</th><th>Autor</th><th>Mensaje</th></tr></thead>
      <tbody>
        {% for c in result.versioning.commit_log %}
        <tr>
          <td><code>{{ c.date[:16].replace('T', ' ') if c.date else '—' }}</code></td>
          <td>{{ c.author }}</td>
          <td>{{ c.message }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <!-- Content analysis -->
  {% if result.content %}
  <div class="card">
    <h2>Análisis de contenido (Claude Sonnet 4.5)</h2>
    <div style="margin-bottom:14px">
      <span style="font-size:13px;color:#64748B">Coherencia: </span>
      <span class="badge {% if result.content.coherence_level == 'Alta' %}badge-success{% elif result.content.coherence_level == 'Media' %}badge-warning{% else %}badge-danger{% endif %}">
        {{ result.content.coherence_level }}
      </span>
    </div>
    {% if result.content.details.requirement_scores %}
    {% for rs in result.content.details.requirement_scores %}
    <div class="file-row {% if rs.achieved_pct >= 100 %}present{% elif rs.achieved_pct > 0 %}{% else %}absent{% endif %}"
         style="{% if 0 < rs.achieved_pct < 100 %}background:#FFFBEB{% endif %}">
      <span>{{ rs.requirement }} <span style="color:#94A3B8">(vale {{ rs.weight_pct }} pts)</span></span>
      <span style="font-weight:600">{{ rs.achieved_pct }}% cumplido — {{ rs.points }} pts</span>
    </div>
    {% endfor %}
    {% else %}
    {% set pesos = result.content.details.requisitos_pesos or {} %}
    {% for req in result.content.requirements_found %}
    <div class="file-row present">
      <span>{{ req }}{% if pesos.get(req) %} <span style="color:#94A3B8">({{ pesos.get(req) | round(1) }} pts)</span>{% endif %}</span>
      <span style="color:#065F46;font-weight:600">Cumple</span>
    </div>
    {% endfor %}
    {% for req in result.content.requirements_missing %}
    <div class="file-row absent">
      <span>{{ req }}{% if pesos.get(req) %} <span style="color:#94A3B8">({{ pesos.get(req) | round(1) }} pts)</span>{% endif %}</span>
      <span style="color:#991B1B;font-weight:600">No cumple</span>
    </div>
    {% endfor %}
    {% endif %}
    {% if result.content.branch_requirements %}
    <div style="margin-top:14px">
      <div style="font-size:12px;color:#64748B;margin-bottom:6px">Requisitos verificados en ramas específicas:</div>
      {% for br in result.content.branch_requirements %}
      <div style="margin-bottom:10px;padding:10px 12px;background:#F8FAFC;border-radius:8px">
        <div style="font-size:12px;font-weight:600;margin-bottom:6px">Rama <code>{{ br.branch }}</code>
          {% if br.archivos_analizados %}<span style="color:#94A3B8;font-weight:400">— {{ br.archivos_analizados | join(', ') }}</span>{% endif %}
        </div>
        {% for req in br.requirements_found %}
        <div class="file-row present"><span>{{ req }}</span><span style="color:#065F46;font-weight:600">Cumple</span></div>
        {% endfor %}
        {% for req in br.requirements_missing %}
        <div class="file-row absent"><span>{{ req }}</span><span style="color:#991B1B;font-weight:600">No cumple</span></div>
        {% endfor %}
        {% if br.summary %}<div style="font-size:12px;color:#475569;margin-top:4px">{{ br.summary }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if result.content.llm_summary %}
    <div style="margin-top:14px;background:#F8FAFC;border-radius:8px;padding:12px 14px;font-size:13px;color:#475569;line-height:1.7">
      {{ result.content.llm_summary }}
    </div>
    {% endif %}
  </div>
  {% endif %}

  <div class="footer">
    Informe generado automáticamente por EvalRepo · Sistema Multi-Agente · UTPL TIC 2025
  </div>
</div>
</body>
</html>
