# ── Anthropic (Claude Sonnet 4.6) ─────────────────────────────────────────────
# Obtener en: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub ────────────────────────────────────────────────────────────────────
# Obtener en: github.com → Settings → Developer settings → Personal access tokens
# Permisos requeridos: repo:read (o public_repo para repos públicos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtener en: supabase.com → Project Settings → API
# IMPORTANTE: usar service_role key, NO la anon key
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Criterios de evaluación ───────────────────────────────────────────────────
# Ruta al archivo YAML de criterios (por defecto usa config/default.yaml)
CRITERIA_PATH=config/default.yaml

# ── Servidor FastAPI ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── LangSmith (opcional) ──────────────────────────────────────────────────────
# Trazabilidad del grafo LangGraph. Crear cuenta en smith.langchain.com
# Descomentar para activar:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=evalrepo-utpl